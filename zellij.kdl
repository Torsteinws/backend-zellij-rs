layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    tab hide_floating_panes=true {
        pane command="nvim" size="80%" focus=true
        pane split_direction="vertical" {
            pane size="60%"
            pane name="zellij log" command="bash" {
                args "-c" "tail -f /tmp/zellij-1000/zellij-log/zellij.log | awk -F '] ' '{print $2}'"
            }
        }
        floating_panes {
            pane cwd="rust" {
                plugin location="file:rust/target/wasm32-wasip1/debug/smart-splits-backend-zellij-rs.wasm"
            }
            pane cwd="rust" command="bash" start_suspended=true {
                args "-c" "cargo build && zellij action start-or-reload-plugin file:target/wasm32-wasip1/debug/smart-splits-backend-zellij-rs.wasm"     
            }
        }
    }
}
